# Live Base mainnet wallet that receives USDC from agents.
# Use an address you control (Coinbase, MetaMask, Rainbow, etc.).
PAY_TO_EVM_ADDRESS=0xYourBaseMainnetAddress

# Coinbase CDP production facilitator (required on mainnet).
# Create a secret API key at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional. Defaults shown.
# NODE_ENV=production
# PORT=4021
# HOST=0.0.0.0
# X402_NETWORK=eip155:8453
# PUBLIC_BASE_URL=https://your-api-host.example


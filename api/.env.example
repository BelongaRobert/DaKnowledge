# Receiving wallet for x402 USDC payments (Base Sepolia by default).
PAY_TO_EVM_ADDRESS=0xYourAddress

# Optional. Defaults shown.
# PORT=4021
# X402_NETWORK=eip155:84532
# FACILITATOR_URL=https://x402.org/facilitator

# Defaults to true (needed for HTTP 402 PAYMENT-REQUIRED). Set false only to skip the boot ping.
# X402_SYNC_FACILITATOR=true

# Mainnet later (do not use the x402.org facilitator):
# X402_NETWORK=eip155:8453
# FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
